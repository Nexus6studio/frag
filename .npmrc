# Vite lists lightningcss (MPL-2.0) as an optional peer for CSS transforms.
# This app does not use it. legacy-peer-deps keeps that peer, and the other
# unused CSS/minifier peers, out of node_modules so the license gate stays
# on MIT / BSD / Apache-2.0 / ISC / 0BSD / Unlicense.
legacy-peer-deps=true
